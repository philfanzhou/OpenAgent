<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XML 文档注释仅在本项目（DTO 契约层）开启，为 Swagger schema 提供描述；
    CS1591（缺少 XML 注释）随之在本项目内关闭——它是文档完备性提示而非正确性问题，
    不属于全局压制（其余项目不生成 XML 文档，不会产生该警告）。
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

</Project>
