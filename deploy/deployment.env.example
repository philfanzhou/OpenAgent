# Copy to a protected, shell-compatible .env outside Git; use it for both Compose stacks.
# Set the public host and credentials. Addresses are derived at container startup.
OPENAGENT_PUBLIC_HOST=localhost
OPENAGENT_ASPNETCORE_ENVIRONMENT=Production
OPENAGENT_POSTGRES_PASSWORD=openagent
OPENAGENT_S3_ACCESS_KEY=openagent
OPENAGENT_S3_SECRET_KEY=openagent-secret
OPENAGENT_KEYCLOAK_ADMIN_PASSWORD=admin

# Optional overrides (defaults below); no frontend rebuild is needed.
# OPENAGENT_PUBLIC_SCHEME=https
# OPENAGENT_CHAT_PORT=8081
# OPENAGENT_ROUTER_PORT=8082
# OPENAGENT_ENGINE_PORT=8083
# OPENAGENT_KEYCLOAK_PORT=58081
# OPENAGENT_TENANT_ID=development
# Override derived URLs only for separate domains or reverse proxies.
# OPENAGENT_CHAT_PUBLIC_URL=https://localhost:8081
# OPENAGENT_ROUTER_PUBLIC_URL=https://localhost:8082
# OPENAGENT_ENGINE_PUBLIC_URL=https://localhost:8083
# OPENAGENT_KEYCLOAK_PUBLIC_URL=https://localhost:58081

# Keep existing project/network names when updating a deployment.
# OPENAGENT_COMPOSE_PROJECT=openagent-app
# OPENAGENT_APP_NETWORK=openagent
# OPENAGENT_INFRA_PROJECT=openagent-infrastructure
# OPENAGENT_INFRA_NETWORK=openagent-infrastructure
# Certificate path must be absolute when overriding the shared default.
# OPENAGENT_TLS_CERT_DIR=/absolute/path/to/certs

# External infrastructure overrides; internal ports differ from published host ports.
# OPENAGENT_POSTGRES_DB=openagent
# OPENAGENT_POSTGRES_USER=openagent
# OPENAGENT_POSTGRES_HOST=postgres
# OPENAGENT_POSTGRES_INTERNAL_PORT=5432
# OPENAGENT_REDIS_HOST=redis
# OPENAGENT_REDIS_INTERNAL_PORT=6379
# OPENAGENT_S3_SERVICE_URL=http://minio:9000
# OPENAGENT_KEYCLOAK_ADMIN_USERNAME=admin
# OPENAGENT_KEYCLOAK_METADATA_ADDRESS=http://keycloak:8080/realms/openagent/.well-known/openid-configuration
# OPENAGENT_ALLOW_INSECURE_TLS=false
# OPENAGENT_NGINX_CLIENT_MAX_BODY_SIZE=1100m
