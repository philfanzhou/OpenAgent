{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Engine": {
    "AllowMockAgent": true,
    "AdvertisedHost": "localhost",
    "AdvertisedPort": 5208
  },
  "Authentication": {
    "Mode": "Basic",
    "AllowTenantHeader": true,
    "AllowDevelopmentAnonymous": true,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development",
  },
  "Authorization": {
    "Mode": "AllowAll"
  },
  "Mcp": {
    "ConnectionTimeoutSeconds": 30,
    "AllowUnlistedCommands": false,
    "AllowedCommands": [ "node", "nodejs", "dotnet", "python", "python3" ]
  },
  "ConversationStore": {
    "EnableColdArchive": false
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Heartbeat": {
    "AdvertisedHost": "localhost",
    "AdvertisedPort": 5208
  }
}
