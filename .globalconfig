# OpenAgent — .globalconfig
# 代码质量规则集配置（与 .editorconfig 互补）
# 文档参考：.agent/rules/coding-conventions.md

is_global = true

# ── 依赖方向约束（通过代码分析器提示） ──
# 实际约束由项目引用关系保证，这里用文档链接提醒
# 详见 .agent/rules/coding-conventions.md §2

# ── 异步规则 ──
dotnet_diagnostic.CA2007.severity = suggestion # ConfigureAwait
dotnet_diagnostic.CA2016.severity = warning    # 传递 CancellationToken

# ── 可空规则 ──
dotnet_diagnostic.CS8618.severity = warning    # 非空字段未初始化

# ── 设计规则 ──
dotnet_diagnostic.CA1001.severity = warning    # 拥有可丢弃字段的类型应实现 IDisposable
dotnet_diagnostic.CA1031.severity = warning    # 不捕获通用异常
dotnet_diagnostic.CA1032.severity = suggestion # 实现标准异常构造函数
dotnet_diagnostic.CA1051.severity = warning    // 不要声明仅可见实例字段
dotnet_diagnostic.CA1062.severity = suggestion // 验证公共方法的参数
dotnet_diagnostic.CA1063.severity = suggestion // 实现 IDisposable 正确
dotnet_diagnostic.CA1806.severity = warning    // 不要忽略方法结果
dotnet_diagnostic.CA1816.severity = warning    // 调用 GC.SuppressFinalize 正确
dotnet_diagnostic.CA1822.severity = suggestion // 将成员标记为 static
dotnet_diagnostic.CA1848.severity = suggestion // 使用 LoggerMessage 源生成器（与 coding-conventions §8.3 一致）
dotnet_diagnostic.CA2000.severity = warning    // 在范围失去之前处理对象
dotnet_diagnostic.CA2007.severity = suggestion // 考虑调用 ConfigureAwait
dotnet_diagnostic.CA2012.severity = warning    // 正确使用 ValueTask
dotnet_diagnostic.CA2016.severity = warning    // 应传递 CancellationToken 参数到方法调用
dotnet_diagnostic.CA2100.severity = warning    // 检查 SQL 注入
dotnet_diagnostic.CA2213.severity = warning    // 应处理可丢弃的字段
dotnet_diagnostic.CA2214.severity = warning    // 不要在构造函数中调用可覆盖的方法
dotnet_diagnostic.CA2234.severity = suggestion // 传递字符串而不是 URI

# ── 命名规则 ──
dotnet_diagnostic.NU1704.severity = warning    // 程序集名称冲突解析

# ── 性能规则 ──
dotnet_diagnostic.CA1805.severity = suggestion // 不要初始化不必要的
dotnet_diagnostic.CA1820.severity = suggestion // 使用字符串长度测试空字符串
dotnet_diagnostic.CA1822.severity = suggestion // 将成员标记为 static
dotnet_diagnostic.CA1825.severity = warning    // 避免零长度数组分配
dotnet_diagnostic.CA1834.severity = suggestion // 使用 StringBuilder 串联
dotnet_diagnostic.CA1848.severity = suggestion // 使用 LoggerMessage 委托

# ── 可靠性规则 ──
dotnet_diagnostic.CA2007.severity = suggestion // ConfigureAwait
dotnet_diagnostic.CA2008.severity = warning    // 不要在未传递 TaskScheduler 的情况下创建任务
dotnet_diagnostic.CA2012.severity = warning    // 正确使用 ValueTask
dotnet_diagnostic.CA2216.severity = warning    // 可处置类型应声明终结器

# ── 安全规则 ──
dotnet_diagnostic.CA2100.severity = warning    // 检查 SQL 命令是否安全
dotnet_diagnostic.CCA0001.severity = warning   // 信任问题
