# Runner 独立部署；通过 docker compose --env-file 读取，不要 source。
# 必填项无可用默认值；其余项即使省略也采用下列默认值。

# 必填（BasicPassword 仅 Basic 模式必填）
# 必填：至少 32 字符；与 Engine 的 CodeExecution__ApiKey 一致
Runner__ApiKey=

# Docker 启动参数（仅 Compose 使用，不注入应用）
OPENAGENT_COMPOSE_PROJECT=openagent-runner
OPENAGENT_RUNNER_IMAGE=openagent-runner:latest
OPENAGENT_RUNNER_PORT=5209
OPENAGENT_APP_NETWORK=openagent-infrastructure

# 可选应用参数及默认值
# ASP.NET Core 环境
ASPNETCORE_ENVIRONMENT=Production
# 单次执行超时，秒
Runner__TimeoutSeconds=120
# 并发执行数
Runner__MaxConcurrentExecutions=2
# 单沙箱内存限制 MiB
Runner__MemoryMiB=1536
# 工作区限制 MiB
Runner__WorkspaceMiB=128
# 单沙箱进程数上限
Runner__MaxProcesses=64
# 会话空闲过期时间，分钟
Runner__SessionIdleMinutes=120
# 会话沙箱上限
Runner__MaxSessionSandboxes=64
# 容器工作区根目录
Runner__WorkspaceRoot=/var/lib/openagent-runner/workspaces
# 容器 bwrap 路径
Runner__BubblewrapPath=/usr/bin/bwrap
# 容器 Python 路径
Runner__PythonPath=/opt/openagent-code/venv/bin/python
# 容器 Node 路径
Runner__NodePath=/usr/bin/node
