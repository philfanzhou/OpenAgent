# Nginx 独立配置。该 .env 由此栈的 Compose --env-file 与容器 env_file 读取。
# 部署脚本仅为证书预检读取本文件，因此路径或 server name 含空格时使用引号。
# 以下模板变量为 [必填]；示例已填入默认值，可直接按部署修改。
OPENAGENT_NGINX_SERVER_NAME=localhost
OPENAGENT_CHAT_PORT=8081
OPENAGENT_ROUTER_PORT=8082
OPENAGENT_ENGINE_PORT=8083
OPENAGENT_NGINX_CLIENT_MAX_BODY_SIZE=1100m

# [必填] 证书目录，需包含 tls.crt 和 tls.key。相对路径以本 Nginx 目录为基准，也可直接填写绝对路径。
# 此值保持原 infrastructure 使用的证书位置。
OPENAGENT_TLS_CERT_DIR=../openagent/nginx/certs
