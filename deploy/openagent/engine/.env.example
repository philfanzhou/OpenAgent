# Engine 专用运行配置；不向 Router / Chat 注入数据库与对象存储密钥。

# [必填] PostgreSQL 完整连接串；直接填写现有数据库密码。含 $ / # 时用单引号包裹整个值。
ConnectionStrings__OpenAgentDatabase=Host=postgres;Port=5432;Database=openagent;Username=openagent;Password=
# [必填] 当前部署在启动时应用数据库迁移。
Database__ApplyMigrationsOnStartup=true
# [必填] 启用文件资产；示例地址为内置 MinIO 的 Docker 内部端口，外接 S3 时直接修改此值。
# 使用 MinIO 时填写其已有 access / secret key；值含 $ / # 时用单引号包裹。
FileAssets__Enabled=true
FileAssets__ObjectStorage__ServiceUrl=http://minio:9000
FileAssets__ObjectStorage__AccessKey=
FileAssets__ObjectStorage__SecretKey=
FileAssets__ObjectStorage__ForcePathStyle=true
# [必填] 服务发现使用容器内部地址。
Heartbeat__AdvertisedHost=engine
Heartbeat__AdvertisedPort=5208

# [可选] 默认来自 Backend/src/OpenAgent.Engine.Host/Dockerfile 的 ENV，省略时仍监听所有网卡 5208。
# 这是镜像默认值；修改时同步 Router 的 Engine 地址、Nginx 上游、心跳和健康检查。
# ASPNETCORE_URLS=http://+:5208
# [可选] 会话缓存默认开启。
# ConversationCache__Enabled=true
# [可选] 默认 bucket openagent-files、region us-east-1，需与实际存储一致。
# FileAssets__ObjectStorage__BucketName=openagent-files
# FileAssets__ObjectStorage__Region=us-east-1
# [可选] 允许 OpenCode 导入原件和导出成品。原生读写权限见部署指南。
# FileExchange__Enabled=true
# [可选] 分享链接的 Engine 公开基地址。
# FileAssets__Share__PublicBaseUrl=https://engine.example.com
# [可选] 默认服务名 openagent-engine。
# OpenTelemetry__ServiceName=openagent-engine
# [可选] 当前 dev 曾显式设置 0 以跳过 Node TLS 校验；需要兼容自签名环境时取消注释。
# NODE_TLS_REJECT_UNAUTHORIZED=0
# [可选] OpenCode 使用附加 CA 时设置容器内 PEM 路径。
# NODE_EXTRA_CA_CERTS=/path/in/container/ca.pem
