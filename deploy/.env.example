# 公共部署参数。运行 scripts/deploy.sh init 后填写 deploy/.env。
# [必填] 保持启用并填写；[可选] 已注释。服务运行配置在 deploy/openagent/ 各 .env 中。
# 本文件由 Bash 部署脚本和 Compose 读取；含空格、$、# 的值用单引号包裹。

# [必填] Nginx 对外主机名，需与证书 SAN 一致。
OPENAGENT_PUBLIC_HOST=localhost
# [必填] 必须匹配既有 PostgreSQL 的密码。
OPENAGENT_POSTGRES_PASSWORD=
# [必填] S3 API 地址（不是管理控制台地址）及现有 access / secret key。
OPENAGENT_S3_SERVICE_URL=
OPENAGENT_S3_ACCESS_KEY=
OPENAGENT_S3_SECRET_KEY=

# [可选] 对外端口，默认 Chat 8081、Router 8082、Engine 8083。
# OPENAGENT_CHAT_PORT=8081
# OPENAGENT_ROUTER_PORT=8082
# OPENAGENT_ENGINE_PORT=8083
# [可选] 覆盖共享认证文件中的 IdP 公开基地址（不含 /realms/openagent）。
# OPENAGENT_KEYCLOAK_PUBLIC_URL=https://sso.example.com
# [可选] 证书目录，覆盖时使用绝对路径，内含 tls.crt / tls.key。
# 默认沿用 deploy/openagent/nginx/certs，兼容未改动的 infrastructure。
# OPENAGENT_TLS_CERT_DIR=/etc/openagent/certs
# [可选] Router 入口请求体上限，默认 1100m。
# OPENAGENT_NGINX_CLIENT_MAX_BODY_SIZE=1100m

# 项目、网络和镜像名称固定在 Compose 中，不接受环境变量覆盖。
# infrastructure 继续按原 Compose 单独管理，本文件不改变其配置。
