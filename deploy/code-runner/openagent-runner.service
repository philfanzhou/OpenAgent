[Unit]
Description=OpenAgent gVisor Code Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openagent-runner
Group=openagent-runner
WorkingDirectory=/opt/openagent-runner/app
EnvironmentFile=/etc/openagent-runner.env
ExecStart=/opt/openagent-runner/app/OpenAgent.Runner
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
# The service only controls the preconfigured rootless Docker daemon. The
# one-shot child containers provide the gVisor boundary for untrusted code.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=no
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/openagent-runner

TasksMax=256
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
