# Engine 独立部署；通过 docker compose --env-file 读取，不要 source。
# 必填项无可用默认值；其余项即使省略也采用下列默认值。

# 必填（BasicPassword 仅 Basic 模式必填）
# 必填：完整 PostgreSQL 连接串，无默认连接或密码
ConnectionStrings__OpenAgentDatabase=
# 必填：S3 API Endpoint，不能使用控制台地址
FileAssets__ObjectStorage__ServiceUrl=
# 必填：S3 Access Key
FileAssets__ObjectStorage__AccessKey=
# 必填：S3 Secret Key
FileAssets__ObjectStorage__SecretKey=
# Basic 密码；Basic 模式必填，无内置部署密码
Authentication__BasicPassword=

# Docker 启动参数（仅 Compose 使用，不注入应用）
OPENAGENT_COMPOSE_PROJECT=openagent-engine
OPENAGENT_ENGINE_IMAGE=openagent-engine:latest
OPENAGENT_ENGINE_PORT=5208
OPENAGENT_APP_NETWORK=openagent-infrastructure

# 可选应用参数及默认值
# ASP.NET Core 环境
ASPNETCORE_ENVIRONMENT=Production
# 可选 Redis；留空时不使用 Redis
ConnectionStrings__Redis=
# S3 bucket；需事先创建
FileAssets__ObjectStorage__BucketName=openagent-files
# 签名区域，按存储商要求覆盖
FileAssets__ObjectStorage__Region=us-east-1
# 是否采用 path-style；MinIO 通常设为 true
FileAssets__ObjectStorage__ForcePathStyle=false
# 对象 key 前缀
FileAssets__ObjectStorage__KeyPrefix=files
# 可选文件分享公开地址
FileAssets__Share__PublicBaseUrl=
# Router 能访问的 Engine 主机名
Heartbeat__AdvertisedHost=engine
# Engine 内部端口
Heartbeat__AdvertisedPort=5208
# 是否启用独立 Runner
CodeExecution__Enabled=false
# 启用代码执行时的 Runner 地址
CodeExecution__Endpoint=http://runner:5209
# 启用代码执行时必填，与 Runner__ApiKey 相同，至少 32 字符
CodeExecution__ApiKey=
# Runner HTTP 超时，秒
CodeExecution__RequestTimeoutSeconds=180
# 认证方式；Basic 或 JwtBearer
Authentication__Mode=Basic
# Basic 用户名
Authentication__BasicUsername=admin
# Basic 用户所属租户；Engine 与 Router 必须一致
Authentication__BasicTenantId=default
# 启用 Keycloak 登录入口；需同时选择 JwtBearer
Authentication__EnableKeycloak=false
# 附加第三方 API Key 认证
Authentication__EnableApiKey=false
# 仅 Development 可启用匿名访问
Authentication__AllowDevelopmentAnonymous=false
# JwtBearer 必填：OIDC issuer
Authentication__Authority=
# JWT audience
Authentication__Audience=openagent-api
# OIDC client ID
Authentication__ClientId=openagent-chat
# 可选 discovery 地址；为空时由 Authority 派生；生产须 HTTPS
Authentication__MetadataAddress=
# 校验 HTTPS 元数据；生产必须 true
Authentication__RequireHttpsMetadata=true
# JWT 时钟容差，秒
Authentication__ClockSkewSeconds=60
# 浏览器前端来源
Cors__AllowedOrigins__0=http://localhost:8081
# 可选外部 OTLP Collector 地址
OpenTelemetry__OtlpEndpoint=
# 是否跳过出站 TLS 证书校验
OPENAGENT_ALLOW_INSECURE_TLS=false
