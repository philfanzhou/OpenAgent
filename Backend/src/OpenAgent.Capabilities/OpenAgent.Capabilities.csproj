<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../OpenAgent.Contracts/OpenAgent.Contracts.csproj" />
    <PackageReference Include="SkiaSharp" />
    <!-- Linux（Docker 部署）的 libSkiaSharp.so 不随主包传递，需显式引用；
         运行镜像需安装 libfontconfig1（见 Engine.Host Dockerfile）。 -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenAgent.Application" />
    <InternalsVisibleTo Include="OpenAgent.Application.Tests" />
    <!-- Engine 的旧执行器回归夹具复用内部文件解析器。 -->
    <InternalsVisibleTo Include="OpenAgent.Engine.Tests" />
    <InternalsVisibleTo Include="OpenAgent.Capabilities.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
