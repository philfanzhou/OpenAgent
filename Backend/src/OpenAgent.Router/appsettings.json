{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Authentication": {
    "Mode": "JwtBearer",
    "Authority": "",
    "Audience": "openagent",
    "RequireHttpsMetadata": true,
    "AllowTenantHeader": false,
    "AllowDevelopmentAnonymous": false,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development"
  },
  "GatewayAuthorization": {
    "Issuer": "openagent-router",
    "Audience": "openagent-engine",
    "SigningKey": "",
    "AudienceSigningKeys": {},
    "GrantLifetimeSeconds": 60,
    "ClockSkewSeconds": 10,
    "AuthenticatedPermissions": [
      "agent.read",
      "agent.execute",
      "model.invoke",
      "tool.use",
      "function.invoke",
      "mcp.use",
      "skill.use",
      "conversation.read",
      "conversation.delete",
      "identity.read"
    ],
    "RolePermissions": {
      "OpenAgent.Admin": [ "*" ]
    }
  },
  "RouterSettings": {
    "RateLimiting": {
      "RequestsPerSecond": 100,
      "BurstCapacity": 200
    },
    "IntentRecognition": {
      "Enabled": true,
      "AgentId": "intent-router",
      "FallbackAgentId": "default",
      "MinimumConfidence": 0.5,
      "TimeoutMs": 5000,
      "MaxCandidates": 100,
      "MaxMessageCharacters": 16000,
      "CatalogCacheSeconds": 15
    },
    "ExternalAgents": {
      "Agents": []
    }
  }
}
