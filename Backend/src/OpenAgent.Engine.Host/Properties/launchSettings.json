        "ConnectionStrings__Redis": "localhost:6379",
        "Authentication__Authority": "http://localhost:5003",
        "Heartbeat__AdvertisedHost": "localhost",
        "Heartbeat__AdvertisedPort": "5208"
      }
    },
    "Testing": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
