# 复制为 .env 后只需填写以下必填项；没有默认凭据。
# 可选覆盖项及其默认值写在对应 docker-compose.yml 的注释中。
# 密码含空格、$、# 等字符时用单引号包裹。

# PostgreSQL：Engine 使用的数据库密码。
OPENAGENT_POSTGRES_PASSWORD=

# Engine：S3 API endpoint（不是管理控制台地址），例如 http://minio:9000。
OPENAGENT_S3_SERVICE_URL=
# Engine / 内置 MinIO：S3 Access Key 与 Secret Key。
OPENAGENT_S3_ACCESS_KEY=
OPENAGENT_S3_SECRET_KEY=

# Engine + Router：Basic 登录密码；两端共享。默认认证方式为 Basic。
OPENAGENT_AUTH_BASIC_PASSWORD=
