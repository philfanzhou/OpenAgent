{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OpenAgentDatabase": "Host=localhost;Port=5432;Database=openagent;Username=openagent;Password=openagent"
  },
  "Storage": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "OpenAgentDatabase"
  },
  "ConversationCache": {
    "Enabled": true,
    "TimeToLiveMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Authentication": {
    "Mode": "Basic",
    "AllowTenantHeader": true,
    "AllowDevelopmentAnonymous": false,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development",
    "ProviderToken": {
      "Issuer": "openagent-router",
      "Audience": "openagent-engine-provider"
    },
  },
  "Authorization": {
    "Mode": "Claims"
  },
  "Mcp": {
    "ConnectionTimeoutSeconds": 30,
    "AllowUnlistedCommands": false,
    "AllowedCommands": []
  },
  "Engine": {
    "AllowMockAgent": false
  },
  "FileAssets": {
    "Enabled": false,
    "MaxFileCount": 5,
    "MaxFileSizeBytes": 10485760,
    "MaxFunctionReadBytes": 131072,
    "AllowedMediaTypes": [ "image/*", "application/pdf", "application/json", "application/vnd.jgraph.mxfile", "text/plain", "text/csv", "text/markdown", "text/html" ],
    "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".pdf", ".json", ".drawio", ".txt", ".csv", ".md", ".html", ".htm" ],
    "ObjectStorage": {
      "BucketName": "openagent-files",
      "KeyPrefix": "files",
      "Region": "us-east-1",
      "ServiceUrl": null,
      "ForcePathStyle": false
    }
  },
  "OpenTelemetry": {
    "ServiceName": "agent-engine",
    "ServiceVersion": "1.0.0"
  },
  "Heartbeat": {
    "IntervalSeconds": 10,
    "RetryDelaySeconds": 5,
    "RegistryTtlSeconds": 30,
    "AdvertisedHost": "",
    "AdvertisedPort": null
  },
  "Shutdown": {
    "TimeoutSeconds": 30
  }
}
