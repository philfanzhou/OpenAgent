{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Authentication": {
    "Mode": "Basic",
    "AllowDevelopmentAnonymous": false,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development"
  },
  "GatewayAuthorization": {
    "SigningKey": "development-only-openagent-gateway-signing-key-2026",
    "AuthenticatedPermissions": [ "*" ]
  },
  "RouterSettings": {
    "Routing": {
      "EngineEndpoint": "http://localhost:5208",
      "WorkflowEndpoint": "http://localhost:5003"
    }
  }
}
