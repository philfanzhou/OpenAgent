# Router 独立部署；通过 docker compose --env-file 读取，不要 source。
# 必填项无可用默认值；其余项即使省略也采用下列默认值。

# 必填（BasicPassword 仅 Basic 模式必填）
# Basic 密码；Basic 模式必填，无内置部署密码
Authentication__BasicPassword=

# Docker 启动参数（仅 Compose 使用，不注入应用）
OPENAGENT_COMPOSE_PROJECT=openagent-router
OPENAGENT_ROUTER_IMAGE=openagent-router:latest
OPENAGENT_ROUTER_PORT=5001
OPENAGENT_APP_NETWORK=openagent-infrastructure

# 可选应用参数及默认值
# ASP.NET Core 环境
ASPNETCORE_ENVIRONMENT=Production
# 必需的 Engine 依赖地址；同 Docker 网络可用默认值
RouterSettings__Routing__EngineEndpoint=http://engine:5208
# 意图识别超时，毫秒
RouterSettings__IntentRecognition__TimeoutMs=30000
# 可选 Redis；留空使用静态路由与本地降级
ConnectionStrings__Redis=
# 认证方式；Basic 或 JwtBearer
Authentication__Mode=Basic
# Basic 用户名
Authentication__BasicUsername=admin
# Basic 用户所属租户；Engine 与 Router 必须一致
Authentication__BasicTenantId=default
# 启用 Keycloak 登录入口；需同时选择 JwtBearer
Authentication__EnableKeycloak=false
# 附加第三方 API Key 认证
Authentication__EnableApiKey=false
# 仅 Development 可启用匿名访问
Authentication__AllowDevelopmentAnonymous=false
# JwtBearer 必填：OIDC issuer
Authentication__Authority=
# JWT audience
Authentication__Audience=openagent-api
# OIDC client ID
Authentication__ClientId=openagent-chat
# 可选 discovery 地址；为空时由 Authority 派生；生产须 HTTPS
Authentication__MetadataAddress=
# 校验 HTTPS 元数据；生产必须 true
Authentication__RequireHttpsMetadata=true
# JWT 时钟容差，秒
Authentication__ClockSkewSeconds=60
# 浏览器前端来源
Cors__AllowedOrigins__0=http://localhost:8081
# 可选外部 OTLP Collector 地址
OpenTelemetry__OtlpEndpoint=
# 是否跳过出站 TLS 证书校验
OPENAGENT_ALLOW_INSECURE_TLS=false
