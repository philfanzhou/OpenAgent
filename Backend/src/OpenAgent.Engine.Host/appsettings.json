{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OpenAgentDatabase": "Host=localhost;Port=5432;Database=openagent;Username=openagent;Password=openagent"
  },
  "Storage": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "OpenAgentDatabase"
  },
  "ConfigurationStore": {
    "RedisCacheTtlSeconds": 300
  },
  "ConversationCache": {
    "Enabled": true,
    "TimeToLiveMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Authentication": {
    "Mode": "JwtBearer",
    "EnableKeycloak": true,
    "Authority": "",
    "Audience": "",
    "ClientId": "",
    "Scopes": [ "openid", "profile", "email", "organization" ],
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 60,
    "AllowDevelopmentAnonymous": false,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development"
  },
  "Authorization": {
    "Mode": "Claims"
  },
  "Mcp": {
    "ConnectionTimeoutSeconds": 600,
    "ClientIdleTimeoutSeconds": 600,
    "DeferredToolThreshold": 20
  },
  "AgentExecution": {
    "ToolCallTimeoutSeconds": 300,
    "ReadToolResultCharBudget": 80000,
    "ExecutionToolResultCharBudget": 40000,
    "McpToolResultCharBudget": 48000,
    "DefaultToolResultCharBudget": 60000
  },
  "FileAssets": {
    "Enabled": false,
    "MaxFileCount": 10,
    "MaxFileSizeBytes": 104857600,
    "MaxFunctionReadBytes": 131072,
    "MaxInlineImageBytes": 4194304,
    "MaxInlineImageCount": 4,
    "InlineImageHistoryTurns": 2,
    "ObjectStorage": {
      "BucketName": "openagent-files",
      "KeyPrefix": "files",
      "Region": "us-east-1",
      "ServiceUrl": null,
      "ForcePathStyle": false
    }
  },
  "OpenTelemetry": {
    "ServiceName": "openagent-engine",
    "ServiceVersion": "1.0.0"
  },
  "Heartbeat": {
    "IntervalSeconds": 10,
    "RetryDelaySeconds": 5,
    "RegistryTtlSeconds": 30,
    "AdvertisedHost": "",
    "AdvertisedPort": null,
    "Intents": [ "chat" ]
  },
  "Shutdown": {
    "TimeoutSeconds": 30
  }
}
