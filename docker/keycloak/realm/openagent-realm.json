{
  "realm": "openagent",
  "enabled": true,
  "organizationsEnabled": true,
  "displayName": "OpenAgent",
  "sslRequired": "NONE",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "OpenAgent user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "openagent-chat",
      "name": "OpenAgent Chat",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:${OPENAGENT_CHAT_PORT}/*"
      ],
      "webOrigins": [
        "http://localhost:${OPENAGENT_CHAT_PORT}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:${OPENAGENT_CHAT_PORT}/*"
      },
      "protocolMappers": [
        {
          "name": "openagent-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "openagent-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "development",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "openagent-api",
      "name": "OpenAgent API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    }
  ]
}
