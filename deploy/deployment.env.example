# OpenAgent 部署配置：一份文件供现有应用和基础设施 Compose 使用。
# 【必填】只有下面 6 项需要填写；每项都标明使用应用和用途，无可用默认值。
# 【可选】以 # 开头的赋值展示默认值；需要覆盖时再取消行首 #；'' 表示空值。
# 密码包含空格、$、# 等字符时用单引号包裹；本文件也会由现有 Shell 脚本读取。

# ========== 1. 必填项 ==========
# Engine / PostgreSQL：数据库连接密码；必填，无默认值。
OPENAGENT_POSTGRES_PASSWORD=
# Engine：S3 API 地址，例如 http://minio:9000；必填，无默认值；不要填写控制台地址。
OPENAGENT_S3_SERVICE_URL=
# Engine / 内置 MinIO：S3 Access Key；必填，无默认值。
OPENAGENT_S3_ACCESS_KEY=
# Engine / 内置 MinIO：S3 Secret Key；必填，无默认值。
OPENAGENT_S3_SECRET_KEY=
# Engine + Router：用户登录密码；Production Basic 必填，无默认值。
OPENAGENT_AUTH_BASIC_PASSWORD=
# Engine + Runner：执行服务之间的认证密钥；必填，无默认值，至少 32 字符。
OPENAGENT_RUNNER_API_KEY=

# ========== 2. Engine：数据库与 S3（可选覆盖） ==========
# OPENAGENT_POSTGRES_HOST=postgres          # 数据库主机；默认使用内置 PostgreSQL 服务名。
# OPENAGENT_POSTGRES_INTERNAL_PORT=5432     # 数据库实际连接端口；不是宿主机映射端口。
# OPENAGENT_POSTGRES_DB=openagent           # Engine 使用的数据库名；内置 PostgreSQL 同时使用该值初始化。
# OPENAGENT_POSTGRES_USER=openagent         # 数据库用户名；内置 PostgreSQL 同时使用该值初始化。
# OPENAGENT_S3_BUCKET=openagent-files       # 文件 bucket；需要预先创建。
# OPENAGENT_S3_REGION=us-east-1             # S3 签名区域；按服务商要求修改。
# OPENAGENT_S3_FORCE_PATH_STYLE=true        # 使用 /bucket/key 寻址；MinIO 通常 true，AWS 通常 false。
# OPENAGENT_SHARE_PUBLIC_BASE_URL=''          # 文件分享公开地址；默认空，使用请求入口生成。

# ========== 3. Engine + Router：Basic 登录（可选覆盖） ==========
# OPENAGENT_AUTH_BASIC_USERNAME=admin       # 登录用户名；两端必须一致。
# OPENAGENT_AUTH_BASIC_TENANT_ID=development # 登录用户所属租户；已有数据应保持原租户值。
# OPENAGENT_ASPNETCORE_ENVIRONMENT=Production # ASP.NET 环境；生产配置要求 Basic 密码，管理接口仅 Development 映射。

# ========== 4. Chat / Nginx：访问入口（可选覆盖） ==========
# OPENAGENT_PUBLIC_HOST=localhost           # 浏览器访问的域名或 IP；换服务器时通常只需覆盖此项。
# OPENAGENT_PUBLIC_SCHEME=https             # 浏览器公开 URL 协议；现有 Nginx 入口使用 HTTPS。
# OPENAGENT_CHAT_PORT=8081                  # Chat 对外端口。
# OPENAGENT_ROUTER_PORT=8082                # Router API 对外端口。
# OPENAGENT_ENGINE_PORT=8083                # Engine API 对外端口。
# OPENAGENT_CHAT_PUBLIC_URL=''                # 默认按协议、主机和 Chat 端口派生；仅外部入口不同时填完整 URL。
# OPENAGENT_TLS_CERT_DIR=''                   # 默认仓库 deploy/openagent/nginx/certs；覆盖时使用绝对路径，含 tls.crt/tls.key。
# Chat 不接收数据库、S3 或 Basic 密码；前端自身设置归前端仓库维护。

# ========== 5. 可选 Keycloak / OIDC（Basic 用户整段跳过） ==========
# 只有切换为 JwtBearer 并显式 --profile keycloak 才需要内置 Keycloak。
# OPENAGENT_AUTH_MODE=Basic                 # 认证方式；启用 OIDC 时改为 JwtBearer。
# OPENAGENT_AUTH_ENABLE_KEYCLOAK=false      # 是否显示 Keycloak 登录入口；启用时改为 true。
# OPENAGENT_KEYCLOAK_PUBLIC_URL=''            # 默认 https://公开主机:Keycloak端口；接外部服务时填其公开 URL。
# OPENAGENT_KEYCLOAK_PORT=58081             # 内置 Keycloak 对外 HTTPS 端口。
# OPENAGENT_KEYCLOAK_METADATA_ADDRESS=''      # 默认从 issuer 派生 discovery；生产自定义地址也必须 HTTPS。
# OPENAGENT_AUTH_AUDIENCE=openagent-api     # JWT 目标 audience；需与身份提供方一致。
# OPENAGENT_AUTH_CLIENT_ID=openagent-chat   # 前端 OIDC client ID；需与身份提供方一致。
# OPENAGENT_KEYCLOAK_ADMIN_USERNAME=admin   # 仅内置 Keycloak 使用的管理员名。
# OPENAGENT_KEYCLOAK_ADMIN_PASSWORD=admin   # 仅内置 Keycloak 使用的管理员密码；选用时设置自己的密码。

# ========== 6. 高级项：Engine + Router ==========
# OPENAGENT_REDIS_HOST=redis                # Redis 主机；默认使用内置服务名。
# OPENAGENT_REDIS_INTERNAL_PORT=6379        # Redis 实际连接端口；不是宿主机映射端口。
# OPENAGENT_AUTH_ENABLE_API_KEY=false       # 额外接受数据库中的第三方 Bearer API Key，不替代 Basic/OIDC。
# OPENAGENT_OTLP_ENDPOINT=''                  # OTLP Collector 地址；默认空，不导出遥测。
# OPENAGENT_SERVICE_VERSION=development     # 遥测中的服务版本标签。
# OPENAGENT_ALLOW_INSECURE_TLS=false        # 是否跳过出站 TLS 证书校验；默认校验证书。

# ========== 7. 高级项：镜像、基础设施端口与 Nginx ==========
# OPENAGENT_ENGINE_IMAGE=openagent-engine:latest # Engine 镜像与标签。
# OPENAGENT_ROUTER_IMAGE=openagent-router:latest # Router 镜像与标签。
# OPENAGENT_RUNNER_IMAGE=openagent-runner:latest # Runner 镜像与标签。
# OPENAGENT_CHAT_IMAGE=openagent-chat:latest     # Chat 镜像与标签。
# OPENAGENT_POSTGRES_PORT=5432              # 内置 PostgreSQL 映射到宿主机的端口。
# OPENAGENT_REDIS_PORT=6379                 # 内置 Redis 映射到宿主机的端口。
# OPENAGENT_MINIO_PORT=9000                 # 内置 MinIO S3 API 的宿主机端口。
# OPENAGENT_MINIO_CONSOLE_PORT=9001         # 内置 MinIO 管理控制台的宿主机端口。
# OPENAGENT_NGINX_CLIENT_MAX_BODY_SIZE=1100m # Nginx 上传请求体上限，保留 multipart 额外空间。

# ========== 8. 高级项：已有部署迁移（保持原值以复用数据卷） ==========
# OPENAGENT_COMPOSE_PROJECT=openagent-app   # 应用 Compose 项目名，同时决定 Engine 密钥卷前缀。
# OPENAGENT_APP_NETWORK=openagent           # 应用容器网络名。
# OPENAGENT_INFRA_PROJECT=openagent-infrastructure # 基础设施项目名，同时决定数据库等数据卷前缀。
# OPENAGENT_INFRA_NETWORK=openagent-infrastructure # 基础设施网络名，Engine/Router 通过它访问依赖。
