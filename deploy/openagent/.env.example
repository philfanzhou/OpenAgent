# Engine / Router 共用运行配置，由 Compose env_file 读取；专用文件可覆盖同名项。
# [必填] 为当前 dev Compose 的部署选择；[可选] 已注释，未设置时使用应用默认值。

# [必填] 生产运行环境。
ASPNETCORE_ENVIRONMENT=Production
# [必填] 既有基础设施中的 Redis 内部地址。
ConnectionStrings__Redis=redis:6379
# [必填] 保留当前 dev Compose 的 JWT + Keycloak 配置（应用 appsettings 自身默认 Basic）。
Authentication__Mode=JwtBearer
Authentication__EnableKeycloak=true
# [必填] 公开 Issuer 与内部 HTTPS discovery，需匹配已有 IdP。
# 以下默认值沿用当前 dev 部署；使用其他 IdP 时在此修改。
Authentication__Authority=${OPENAGENT_KEYCLOAK_PUBLIC_URL:-https://agent.monolithicpower.com:8443}/realms/openagent
Authentication__MetadataAddress=https://openagent-infrastructure-keycloak-1:8443/realms/openagent/.well-known/openid-configuration
Authentication__Audience=openagent-api
Authentication__ClientId=openagent-chat

# [可选] 默认 false，不允许开发匿名访问，不启用数据库第三方 API Key 认证。
# Authentication__AllowDevelopmentAnonymous=false
# Authentication__EnableApiKey=false
# [可选] 默认要求 HTTPS metadata，JWT 时钟容差为 60 秒。
# Authentication__RequireHttpsMetadata=true
# Authentication__ClockSkewSeconds=60
# [可选] 若手动改用 Basic，用户名 / 租户默认 admin / development，生产须另设密码。
# Authentication__BasicUsername=admin
# Authentication__BasicTenantId=development
# Authentication__BasicPassword=replace-with-a-unique-password
# [可选] 自定义浏览器来源；dev 的应用默认允许所有来源。
# Cors__AllowedOrigins__0=https://chat.example.com
# [可选] 默认验证出站 TLS 证书，优先安装受信任的 CA。
# OPENAGENT_ALLOW_INSECURE_TLS=false

# [可选] 审计 / 遥测出口，默认不导出。启用 HTTP OTLP 时同时设置 protocol。
# 通用出口 / 令牌（保持现有 Compose 的变量入口）：
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
# OTEL_EXPORTER_OTLP_HEADERS='Authorization=Bearer replace-with-token'
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_EXPORTER=otlp
# [可选] 仅将 traces 发送到审计掩码网关，避免日志与指标使用同一出口及令牌。
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://audit.example.com
# OTEL_EXPORTER_OTLP_TRACES_HEADERS='Authorization=Bearer replace-with-token'
# [可选] .NET 配置格式的通用 Collector 地址（覆盖 OTEL 通用地址）。
# OpenTelemetry__OtlpEndpoint=https://collector.example.com
# [可选] 遥测版本，应用默认 1.0.0。
# OpenTelemetry__ServiceVersion=development
