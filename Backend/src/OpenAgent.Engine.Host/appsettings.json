{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "protocol": "HttpProtobuf",
          "resourceAttributes": {
            "service.name": "agent-engine",
            "service.version": "1.0.0",
            "app": "open-agent",
            "env": "prod"
          }
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Authentication": {
    "Mode": "JwtBearer",
    "Authority": "",
    "Audience": "openagent-engine",
    "RequireHttpsMetadata": true,
    "AllowTenantHeader": false,
    "AllowDevelopmentPassThrough": false,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development",
    "Providers": {},
    "Login": {
      "Password": {
        "Enabled": false,
        "SsoAddress": "",
        "TokenEndpoint": "",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "openid profile email"
      },
      "Microsoft": {
        "Enabled": false,
        "Authority": "",
        "AuthorizationEndpoint": "",
        "TokenEndpoint": "",
        "ClientId": "",
        "ClientSecret": "",
        "RedirectUri": "http://localhost:5173/auth/callback",
        "Scopes": [ "openid", "profile", "email" ]
      }
    }
  },
  "Authorization": {
    "Mode": "Claims"
  },
  "Mcp": {
    "ConnectionTimeoutSeconds": 30,
    "AllowUnlistedCommands": false,
    "AllowedCommands": []
  },
  "Engine": {
    "AllowMockAgent": false
  },
  "Attachments": {
    "MaxFileCount": 5,
    "MaxFileSizeBytes": 10485760,
    "MaxTotalSizeBytes": 26214400,
    "AllowedMediaTypes": [ "image/*", "application/pdf", "application/json", "text/plain", "text/csv", "text/markdown" ],
    "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".gif", ".webp", ".pdf", ".json", ".txt", ".csv", ".md" ]
  },
  "ConversationStore": {
    "EnableColdArchive": false
  },
  "OpenTelemetry": {
    "ServiceName": "agent-engine",
    "ServiceVersion": "1.0.0"
  },
  "Heartbeat": {
    "IntervalSeconds": 10,
    "RetryDelaySeconds": 5,
    "RegistryTtlSeconds": 30,
    "AdvertisedHost": "",
    "AdvertisedPort": null
  },
  "Shutdown": {
    "TimeoutSeconds": 30
  }
}
