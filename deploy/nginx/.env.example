# Nginx 仅接收模板变量；公共域名与宿主端口由 deploy/.env 统一配置。
# 以下模板占位符均为 [必填]，默认值从公共配置派生。
OPENAGENT_NGINX_SERVER_NAME=${OPENAGENT_PUBLIC_HOST:-localhost}
OPENAGENT_CHAT_PORT=${OPENAGENT_CHAT_PORT:-8081}
OPENAGENT_ROUTER_PORT=${OPENAGENT_ROUTER_PORT:-8082}
OPENAGENT_ENGINE_PORT=${OPENAGENT_ENGINE_PORT:-8083}
# 请求体上限模板也需要值，默认 1100m；仅在公共 deploy/.env 中覆盖。
OPENAGENT_NGINX_CLIENT_MAX_BODY_SIZE=${OPENAGENT_NGINX_CLIENT_MAX_BODY_SIZE:-1100m}
