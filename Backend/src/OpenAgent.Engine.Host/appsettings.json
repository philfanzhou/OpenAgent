{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Authentication": {
    "Mode": "Gateway",
    "AllowTenantHeader": false,
    "AllowDevelopmentAnonymous": false,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development"
  },
  "GatewayAuthorization": {
    "Issuer": "openagent-router",
    "Audience": "openagent-engine",
    "SigningKey": "",
    "GrantLifetimeSeconds": 60,
    "ClockSkewSeconds": 10,
    "AuthenticatedPermissions": [],
    "RolePermissions": {}
  },
  "Authorization": {
    "Mode": "Claims"
  },
  "Mcp": {
    "ConnectionTimeoutSeconds": 30,
    "AllowUnlistedCommands": false,
    "AllowedCommands": []
  },
  "Engine": {
    "AllowMockAgent": false
  },
  "Attachments": {
    "MaxFileCount": 5,
    "MaxFileSizeBytes": 10485760,
    "MaxTotalSizeBytes": 26214400,
    "AllowedMediaTypes": [ "image/*", "application/pdf", "application/json", "text/plain", "text/csv", "text/markdown" ],
    "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".gif", ".webp", ".pdf", ".json", ".txt", ".csv", ".md" ],
    "ObjectStorage": {
      "Enabled": false,
      "BucketName": "openagent-attachments",
      "KeyPrefix": "attachments",
      "Region": "us-east-1",
      "ServiceUrl": null,
      "ForcePathStyle": false
    }
  },
  "ConversationStore": {
    "EnableColdArchive": false
  },
  "OpenTelemetry": {
    "ServiceName": "agent-engine",
    "ServiceVersion": "1.0.0"
  },
  "Heartbeat": {
    "IntervalSeconds": 10,
    "RetryDelaySeconds": 5,
    "RegistryTtlSeconds": 30,
    "AdvertisedHost": "",
    "AdvertisedPort": null
  },
  "Shutdown": {
    "TimeoutSeconds": 30
  }
}
