{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Engine": {
    "AllowMockAgent": true,
    "AdvertisedHost": "localhost",
    "AdvertisedPort": 5208
  },
  "Authentication": {
    "Mode": "PassThrough",
    "AllowTenantHeader": true,
    "AllowDevelopmentPassThrough": true,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development",
    "Providers": {},
    "Login": {
      "Password": {
        "Enabled": false,
        "SsoAddress": "",
        "TokenEndpoint": "",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "openid profile email"
      },
      "Microsoft": {
        "Enabled": false,
        "Authority": "",
        "AuthorizationEndpoint": "",
        "TokenEndpoint": "",
        "ClientId": "",
        "ClientSecret": "",
        "RedirectUri": "http://localhost:5173/auth/callback",
        "Scopes": [ "openid", "profile", "email" ]
      }
    }
  },
  "Authorization": {
    "Mode": "AllowAll"
  },
  "Mcp": {
    "ConnectionTimeoutSeconds": 30,
    "AllowUnlistedCommands": false,
    "AllowedCommands": [ "node", "nodejs", "dotnet", "python", "python3" ]
  },
  "ConversationStore": {
    "EnableColdArchive": false
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Heartbeat": {
    "AdvertisedHost": "localhost",
    "AdvertisedPort": 5208
  }
}
