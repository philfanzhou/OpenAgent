# Copy to a protected file outside Git and pass --env-file to BOTH deployments.
# Relative certificate paths are relative to each compose directory. Use an
# absolute OPENAGENT_TLS_CERT_DIR when overriding the shared default.
OPENAGENT_PUBLIC_HOST=localhost
OPENAGENT_PUBLIC_SCHEME=https
OPENAGENT_CHAT_PORT=8081
OPENAGENT_CHAT_PUBLIC_URL=https://localhost:8081
OPENAGENT_ROUTER_PORT=8082
OPENAGENT_ENGINE_PORT=8083
OPENAGENT_KEYCLOAK_PORT=58081
OPENAGENT_KEYCLOAK_PUBLIC_URL=https://localhost:58081
OPENAGENT_KEYCLOAK_METADATA_ADDRESS=http://keycloak:8080/realms/openagent/.well-known/openid-configuration
OPENAGENT_COMPOSE_PROJECT=openagent-app
OPENAGENT_INFRA_PROJECT=openagent-infrastructure
OPENAGENT_INFRA_NETWORK=openagent-infrastructure
OPENAGENT_ASPNETCORE_ENVIRONMENT=Production
OPENAGENT_S3_SERVICE_URL=http://minio:9000
OPENAGENT_S3_ALLOW_INSECURE_TLS=false
# Database/Redis INTERNAL ports are independent of published host ports.
OPENAGENT_POSTGRES_HOST=postgres
OPENAGENT_POSTGRES_INTERNAL_PORT=5432
OPENAGENT_REDIS_HOST=redis
OPENAGENT_REDIS_INTERNAL_PORT=6379
# Supply installation-specific passwords separately; never commit credentials.
