{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Engine": {
    "AllowMockAgent": true,
    "AdvertisedHost": "localhost",
    "AdvertisedPort": 5208
  },
  "ConversationStore": {
    "EnableColdArchive": false
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Heartbeat": {
    "AdvertisedHost": "localhost",
    "AdvertisedPort": 5208
  }
}
