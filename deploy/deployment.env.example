# 单份部署配置；按应用归属分区。两套现有 Compose 共用本文件。
# 必填项无可用默认值；其余项省略时使用注释给出的默认值。
# Engine 必填：PostgreSQL + S3（Bucket 需预先存在）。
OPENAGENT_POSTGRES_PASSWORD=
OPENAGENT_S3_SERVICE_URL=
OPENAGENT_S3_ACCESS_KEY=
OPENAGENT_S3_SECRET_KEY=
# Engine + Router：Basic 默认认证；Production 必须填写密码。
OPENAGENT_AUTH_BASIC_PASSWORD=
# Engine + Runner：共享执行密钥，至少 32 字符。
OPENAGENT_RUNNER_API_KEY=

# Engine + Router 共用的默认值
OPENAGENT_ASPNETCORE_ENVIRONMENT=Production
# OPENAGENT_AUTH_MODE=Basic
# OPENAGENT_AUTH_BASIC_USERNAME=admin
# OPENAGENT_AUTH_BASIC_TENANT_ID=development
# OPENAGENT_AUTH_ENABLE_KEYCLOAK=false
# OPENAGENT_AUTH_ENABLE_API_KEY=false
# OPENAGENT_AUTH_ALLOW_DEVELOPMENT_ANONYMOUS=false
# OPENAGENT_OTLP_ENDPOINT=
# OPENAGENT_SERVICE_VERSION=development
# OPENAGENT_ALLOW_INSECURE_TLS=false

# Engine：数据库与对象存储；Router/Runner/Chat 不接收这些凭据。
# OPENAGENT_POSTGRES_HOST=postgres
# OPENAGENT_POSTGRES_INTERNAL_PORT=5432
# OPENAGENT_POSTGRES_DB=openagent
# OPENAGENT_POSTGRES_USER=openagent
# OPENAGENT_S3_BUCKET=openagent-files
# OPENAGENT_S3_REGION=us-east-1
# OPENAGENT_S3_FORCE_PATH_STYLE=true
# OPENAGENT_SHARE_PUBLIC_BASE_URL=

# Engine + Router：Redis，容器内部端口与宿主映射端口分开。
# OPENAGENT_REDIS_HOST=redis
# OPENAGENT_REDIS_INTERNAL_PORT=6379

# 可选基础设施的宿主映射端口
# OPENAGENT_POSTGRES_PORT=5432
# OPENAGENT_REDIS_PORT=6379
# OPENAGENT_MINIO_PORT=9000
# OPENAGENT_MINIO_CONSOLE_PORT=9001

# 应用镜像；Chat 仅使用镜像，前端自身配置归前端仓库维护。
# OPENAGENT_ENGINE_IMAGE=openagent-engine:latest
# OPENAGENT_ROUTER_IMAGE=openagent-router:latest
# OPENAGENT_RUNNER_IMAGE=openagent-runner:latest
# OPENAGENT_CHAT_IMAGE=openagent-chat:latest

# Nginx 与公开入口；CORS 默认由前端公开 URL 派生。
# OPENAGENT_PUBLIC_HOST=localhost
# OPENAGENT_PUBLIC_SCHEME=https
# OPENAGENT_CHAT_PORT=8081
# OPENAGENT_ROUTER_PORT=8082
# OPENAGENT_ENGINE_PORT=8083
# OPENAGENT_CHAT_PUBLIC_URL=https://localhost:8081
# OPENAGENT_TLS_CERT_DIR=
# 留空时使用各 Compose 的现有证书目录；覆盖时使用绝对路径。
# OPENAGENT_NGINX_CLIENT_MAX_BODY_SIZE=1100m

# Compose：保留原项目名、网络名及数据卷。
# OPENAGENT_COMPOSE_PROJECT=openagent-app
# OPENAGENT_APP_NETWORK=openagent
# OPENAGENT_INFRA_PROJECT=openagent-infrastructure
# OPENAGENT_INFRA_NETWORK=openagent-infrastructure

# 可选 Keycloak：Basic 不需要；显式 --profile keycloak 才启动。
# OPENAGENT_KEYCLOAK_PORT=58081
# OPENAGENT_KEYCLOAK_PUBLIC_URL=https://localhost:58081
# OPENAGENT_KEYCLOAK_METADATA_ADDRESS=
# 留空时从公开 Authority 派生。
# OPENAGENT_AUTH_AUDIENCE=openagent-api
# OPENAGENT_AUTH_CLIENT_ID=openagent-chat
# OPENAGENT_AUTH_REQUIRE_HTTPS_METADATA=true
# OPENAGENT_AUTH_CLOCK_SKEW_SECONDS=60
# OPENAGENT_KEYCLOAK_ADMIN_USERNAME=admin
# OPENAGENT_KEYCLOAK_ADMIN_PASSWORD=admin
# OPENAGENT_KEYCLOAK_COMMAND='start --import-realm'
# OPENAGENT_KEYCLOAK_BACKCHANNEL_DYNAMIC=true
# OPENAGENT_KEYCLOAK_HTTP_ENABLED=true
